# ── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then apply supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for the ingestion pipeline and admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI provider (swappable: anthropic | openai | gemini) ────────────────────
AI_PROVIDER=anthropic
# Optional model override; sensible defaults are used per provider.
# AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ── Embeddings (openai | gemini | none). Used for duplicate detection and
#    future semantic search. Falls back gracefully when unset. ──────────────
EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
