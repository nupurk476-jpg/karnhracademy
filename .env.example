# Copy this file to .env for local dev, then fill in the publishable key from
# the Supabase dashboard: Settings -> API Keys. The URL and project id are
# stable and safe to keep here; the key is deliberately NOT checked in.
#
# Not because it's secret -- it is meant to be exposed client-side and is
# protected by RLS -- but because a copy pinned in git goes stale silently.
# Supabase rotates these and is retiring legacy JWT (eyJ...) keys in favour of
# sb_publishable_... ones. A dead key doesn't fail loudly: PostgREST answers
# {"message":"Invalid API key"}, supabase-js turns that into a rejected
# promise, React Query swallows it, and pages render their full shell with
# zero rows and a clean console. Read the key from the dashboard so the
# copy you deploy is the live one.
#
# Never put SUPABASE_SERVICE_ROLE_KEY in .env -- it's git-tracked-by-default
# territory and that key bypasses RLS entirely. publish-blog.mjs looks for
# it in .env.local instead, which is already gitignored.
#
# These are build-time values: Vite inlines them into the bundle, so changing
# one in Vercel does nothing until the next deploy rebuilds without cache.

VITE_SUPABASE_PROJECT_ID="miynvbkcufwrofgdrtap"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://miynvbkcufwrofgdrtap.supabase.co"
