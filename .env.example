# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# VITE_* variables are compiled into the browser bundle and are PUBLIC. Anyone
# can read them in devtools. Only ever put publishable/anon keys here.
# Anything secret belongs in Supabase Edge Function secrets, never in a VITE_
# variable and never in this file with a real value.

# ── Supabase (client, public) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# ── Razorpay (Phase 2) ───────────────────────────────────────────────────
# The key id is public and safe in the bundle; it is what Razorpay Checkout
# is opened with.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# ── Server-side secrets — Edge Functions ONLY ────────────────────────────
# Set these with `supabase secrets set NAME=value`, never in this file and
# never with a VITE_ prefix. Listed here only so the required names are known.
#
#   RAZORPAY_KEY_ID          same id as above, for the server
#   RAZORPAY_KEY_SECRET      signs and verifies payments — full payment access
#   SUPABASE_SERVICE_ROLE_KEY  bypasses every RLS policy — full database access
#
# If either of the last two ever reaches the browser bundle or a commit,
# rotate it immediately; treat it as compromised rather than probably fine.
